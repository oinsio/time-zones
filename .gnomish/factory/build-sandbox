#!/usr/bin/env bash
# Builds the sandbox image the factory runs gnomes in when bound to `container`.
# The tag is factory.sandbox.image from ~/.gnomish/projects/time-zones/project.yaml, as the
# factory itself resolves it (`gnomish project show`); every tool version comes from the
# repository itself:
#   pnpm        — packageManager in package.json
#   openspec    — devDependencies of package.json
#   playwright  — the version pnpm-lock.yaml resolves (a Chromium build belongs to one release)
# Re-run it after bumping any of them, and bump the tag in project.yaml so a running factory
# never mixes two images under one name.
#
#   .gnomish/factory/build-sandbox                 # build
#   .gnomish/factory/build-sandbox --no-cache      # extra flags go to `docker build`
set -euo pipefail

factory_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd "$factory_dir/../.." && pwd)"

# The value the factory will run, read through the wrapper so the same project name and
# factory home apply: "  factory.sandbox.image = <tag>  [sandbox-boundary]  <origin>".
# The project name comes from gnomish.env, gnomish.local.env or your shell, as in the wrapper.
project_name="${GNOMISH_PROJECT_NAME:-$(bash -c '
    for env_file in "$1/gnomish.env" "$1/gnomish.local.env"; do
        [[ -f "$env_file" ]] && source "$env_file"
    done
    printf "%s" "${GNOMISH_PROJECT_NAME:-}"' _ "$factory_dir")}"
image="$("$factory_dir/gnomish" project show "$project_name" 2>/dev/null \
    | sed -n 's/^ *factory\.sandbox\.image = \([^ ]*\) .*$/\1/p')"
if [[ -z "$image" || "$image" == "null" ]]; then
    echo "build-sandbox: factory.sandbox.image is not set — see project.yaml.example.container and run: .gnomish/factory/gnomish project show $project_name" >&2
    exit 1
fi

node_version="$(tr -d '[:space:]' < "$project_dir/.nvmrc")"
pnpm_version="$(jq -r '.packageManager | sub("^pnpm@"; "") | sub("\\+.*$"; "")' "$project_dir/package.json")"
openspec_version="$(jq -r '.devDependencies["@fission-ai/openspec"]' "$project_dir/package.json")"
playwright_version="$(sed -n 's/^  playwright@\([0-9][^:]*\):$/\1/p' "$project_dir/pnpm-lock.yaml" | head -1)"

for pair in "node:$node_version" "pnpm:$pnpm_version" "openspec:$openspec_version" "playwright:$playwright_version"; do
    if [[ -z "${pair#*:}" || "${pair#*:}" == "null" ]]; then
        echo "build-sandbox: could not read the ${pair%%:*} version from the repository" >&2
        exit 1
    fi
done

echo "build-sandbox: $image (node $node_version, pnpm $pnpm_version, openspec $openspec_version, playwright $playwright_version)" >&2
exec docker build \
    --tag "$image" \
    --build-arg "NODE_VERSION=$node_version" \
    --build-arg "PNPM_VERSION=$pnpm_version" \
    --build-arg "OPENSPEC_VERSION=$openspec_version" \
    --build-arg "PLAYWRIGHT_VERSION=$playwright_version" \
    "$@" \
    "$factory_dir/sandbox"
