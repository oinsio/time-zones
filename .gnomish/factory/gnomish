#!/usr/bin/env bash
# Wrapper around the locally built Gnomish Factory jar (gnomish.jar next to it, git-ignored).
# Everything that launches the factory lives here in .gnomish/factory/; the rest of .gnomish/
# (config.yaml, pipeline.yaml, stages/) is the project's pipeline, which the factory reads
# itself. Callable from any directory.
#
# The factory's settings live in its home, not in this repository: this clone is registered
# once as project time-zones, and ~/.gnomish/projects/time-zones/project.yaml holds the
# binding, the sandbox image, the egress allowlist and the rest (templates beside this script:
# project.yaml.example.host, project.yaml.example.container). This wrapper's own settings —
# the project name, the log level, the Java launcher — live in gnomish.env; gnomish.local.env
# (git-ignored, optional) overrides it.
#
# Adds the one default every invocation needs, then passes the rest through:
#   --dir=<this project, absolute>     (a relative --dir is not recognised as a git repo in git mode)
# A --dir=... of your own REPLACES it rather than joining it: Spring joins a repeated
# command-line option with a comma instead of letting the last one win.
#
#   .gnomish/factory/gnomish run --task="..." --mode=in-place --interactive
#   .gnomish/factory/gnomish status <task-id>
#   .gnomish/factory/gnomish project show time-zones    # every setting with its origin
#
# ---------------------------------------------------------------------------
# Secrets
#
# The factory reads its own secrets (GNOMISH_GITHUB_TOKEN, GNOMISH_GITHUB_ACTIONS_TOKEN) from
# ~/.gnomish/projects/time-zones/secrets/<NAME>, then ~/.gnomish/secrets/<NAME> — the file
# name is the variable name, the file IS the value, and anything wider than 600 is refused:
#
#   install -m 600 /dev/null ~/.gnomish/projects/time-zones/secrets/GNOMISH_GITHUB_TOKEN
#
# Two more credentials are not factory secrets but plain variables a child process reads from
# its environment, so this wrapper exports them from the same folders (see below):
# CLAUDE_CODE_OAUTH_TOKEN and GH_TOKEN.
set -euo pipefail

factory_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The project root holds .gnomish/factory/, wherever the script is called from.
project_dir="$(cd "$factory_dir/../.." && pwd)"

# Load gnomish.env, then gnomish.local.env, without letting either outrank the caller: every
# GNOMISH_* variable already exported is snapshotted first and re-applied after. At top level
# on purpose — the re-applying `declare` inside a function would make the variables local.
caller_settings="$(while read -r name; do
    [[ "$name" == GNOMISH_* ]] && declare -p "$name"
done < <(compgen -e))" || true
set -a  # every assignment in the env files is exported, as a .env file implies
for env_file in "$factory_dir/gnomish.env" "$factory_dir/gnomish.local.env"; do
    if [[ -f "$env_file" ]]; then
        # shellcheck source=/dev/null
        source "$env_file"
    fi
done
set +a
eval "$caller_settings"
unset caller_settings env_file

if [[ -z "${GNOMISH_PROJECT_NAME:-}" ]]; then
    echo "gnomish: GNOMISH_PROJECT_NAME is not set — it belongs in $factory_dir/gnomish.env" >&2
    exit 2
fi
factory_home="${GNOMISH_HOME:-$HOME/.gnomish}"
# Project folder first, host folder second — the order the factory itself resolves secrets in.
secret_dirs=("$factory_home/projects/$GNOMISH_PROJECT_NAME/secrets" "$factory_home/secrets")

# The first non-empty file named $1 in the secret folders, printed as a path.
find_secret_file() {
    local name="$1" secret_dir
    for secret_dir in "${secret_dirs[@]}"; do
        if [[ -s "$secret_dir/$name" ]]; then
            printf '%s' "$secret_dir/$name"
            return 0
        fi
    done
    return 1
}

# Exports $1 with the contents of the first secret file among the remaining names, unless the
# caller already exported it. Only a non-empty value is exported: an empty one would not read
# as "unset" to the consumer — for the agent CLI it would override this host's keychain login
# with a credential that cannot authenticate.
export_from_secret() {
    local var="$1" name file value
    shift
    [[ -z "${!var:-}" ]] || return 0
    for name in "$@"; do
        file="$(find_secret_file "$name")" || continue
        value="$(tr -d '[:space:]' < "$file")"
        if [[ -n "$value" ]]; then
            export "$var=$value"
        fi
        return 0
    done
}

# The agent CLI's credential. On this host the CLI could log in from ~/.claude, but a box has
# no keychain to log in from: the factory sets CLAUDE_CODE_OAUTH_TOKEN on agent rounds and
# judge votes from its OWN environment (its AI seam), not from the secrets folder, so it has to
# be exported here. It needs no passthrough entry and never reaches a command check.
#
#   claude setup-token
#   install -m 600 /dev/null ~/.gnomish/projects/time-zones/secrets/CLAUDE_CODE_OAUTH_TOKEN
export_from_secret CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN

# The deliver stage runs `gh` — in the gnome's round and in that stage's own command checks —
# and `gh` takes its credential from GH_TOKEN. The tracker's GNOMISH_GITHUB_TOKEN cannot serve
# it: the factory declares that name a credential, so it is scrubbed from every child
# environment and refused in the passthrough allowlist by construction. GH_TOKEN reaches the
# children through factory.sandbox.env-passthrough in project.yaml, which copies it from this
# process's environment — hence the export.
#
# A fine-grained token scoped to Contents + Pull requests in secrets/GH_TOKEN keeps the gnome
# from holding the tracker's own rights; without it the tracker token is reused.
export_from_secret GH_TOKEN GH_TOKEN GNOMISH_GITHUB_TOKEN

# --dir, unless the caller passed one — see the note at the top on why it is not simply outranked.
dir_default=(--dir="$project_dir")
for arg in "$@"; do
    if [[ "$arg" == --dir=* || "$arg" == --dir ]]; then
        dir_default=()
        break
    fi
done

exec "${GNOMISH_JAVA:-java}" -jar "$factory_dir/gnomish.jar" \
    ${dir_default[@]+"${dir_default[@]}"} \
    "$@"
