# Settings of the wrapper scripts in .gnomish/factory/, sourced by them as bash.
#
# The factory's own settings (factory.*) are NOT here: the factory reads them from its home —
# ~/.gnomish/projects/time-zones/project.yaml for this project, ~/.gnomish/factory.yaml for
# the whole host. The sandbox boundary (binding, image, egress allowlist, env passthrough) is
# read from project.yaml and nowhere else. Templates beside this file, one per binding:
# project.yaml.example.host and project.yaml.example.container.
#
# Reference: https://github.com/oinsio/gnomish-factory
#   docs/guides/operator-guide.md          — factory home, project registry, levels, secrets
#   docs/guides/operator-guide-serve.md    — factory.serve.*
#   docs/guides/operator-guide-sandbox.md  — factory.bindings.*, factory.sandbox.*

# ---------------------------------------------------------------------------
# Wrapper and logging

# The name this clone is registered under (`gnomish project add <name> --dir=...`). Keys the
# project folder ~/.gnomish/projects/<name>/: settings, secrets, logs, serve state, worktrees.
GNOMISH_PROJECT_NAME=time-zones

# Root log level: TRACE, DEBUG, INFO, WARN, ERROR. An unrecognized value resolves to DEBUG.
GNOMISH_LOG_LEVEL=INFO

# The Java launcher that runs gnomish.jar.
GNOMISH_JAVA=java

# ---------------------------------------------------------------------------
# gnomish-up (daemon + dashboard + log follower in one terminal)

# Where the rendered dashboard page and its render log go. Inside the clone, git-ignored.
GNOMISH_DASHBOARD_DIR="$(dirname "${BASH_SOURCE[0]}")/logs"

# Parallel task slots for `serve` when no --slots is passed.
GNOMISH_UP_SLOTS=1

# How long to wait for the first dashboard render before opening the browser anyway.
GNOMISH_UP_RENDER_WAIT_SECONDS=30
