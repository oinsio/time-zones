# Settings of this factory instance, sourced by .gnomish/factory/gnomish as bash
#
# $GNOMISH_PROJECT_NAME is this clone's directory name — the same key the factory uses for
# ~/.gnomish/worktrees/<project>, so two clones never share a token or a log by accident.
#
# Reference: https://github.com/oinsio/gnomish-factory
#   docs/guides/operator-guide.md          — instance-name, tracker backoff, timeouts, agent CLI
#   docs/guides/operator-guide-serve.md    — factory.serve.*
#   docs/guides/operator-guide-sandbox.md  — factory.bindings.*, factory.sandbox.*

# ---------------------------------------------------------------------------
# Instance

# This instance's diagnostic name (factory.instance-name): keys logs, serve state and claim
# ids, and shows up in PUBLIC issue comments — keep it non-sensitive. Two clones served at
# once need two names.
FACTORY_INSTANCENAME=time-zones

# ---------------------------------------------------------------------------
# Sandbox

# Where gnome processes run: `host` (this machine, as you, no isolation) or `container` (an
# ephemeral Docker box per task behind a default-deny egress guard). Every stage of the
# pipeline binds alike. To run in Docker, build the image once and switch per run or for good:
#   .gnomish/factory/build-sandbox
#   FACTORY_BINDINGS_DEFAULT=container .gnomish/factory/gnomish run --task="..."
#   # or put FACTORY_BINDINGS_DEFAULT=container into gnomish.local.env
FACTORY_BINDINGS_DEFAULT=host

# The box image, built from sandbox/Dockerfile by build-sandbox, which reads this tag. Bump
# the tag whenever the image changes (a new pnpm, openspec or Playwright in the repository).
FACTORY_SANDBOX_IMAGE=time-zones-gnomish-sandbox:1

# The only hosts a box may reach: the agent's provider, the npm registry (pnpm install in the
# implement stage) and the GitHub API (gh in the deliver stage). Every denial is listed by
# `gnomish status` — add a host here only once you know which tool asked for it.
FACTORY_SANDBOX_EGRESSALLOWLIST=api.anthropic.com,registry.npmjs.org,api.github.com

# Vitest, a vite build and headless Chromium in one box outgrow the 2 CPU / 2g defaults.
FACTORY_SANDBOX_LIMITS_CPUS=4
FACTORY_SANDBOX_LIMITS_MEMORY=4g

# Every child process gets a positive environment allowlist, host mode included. GH_TOKEN is
# what `gh` in the deliver stage authenticates with; the wrapper exports it from the secrets
# directory (github-pr-token, falling back to github-token).
FACTORY_SANDBOX_ENVPASSTHROUGH=GH_TOKEN

# ---------------------------------------------------------------------------
# Wrapper and logging

# Where the per-project secret files live (github-token, github-actions-token,
# claude-oauth-token). Keep it OUTSIDE the clone — a token in the tree is one you can commit.
GNOMISH_SECRETS_DIR="$HOME/.gnomish/secrets/$GNOMISH_PROJECT_NAME"

# Log directory. The factory's own default is one file per host, which interleaves two
# clones' narratives into a single gnomish.log.
GNOMISH_LOG_DIR="$HOME/.gnomish/logs/$GNOMISH_PROJECT_NAME"

# Root log level: TRACE, DEBUG, INFO, WARN, ERROR. An unrecognized value resolves to DEBUG.
GNOMISH_LOG_LEVEL=INFO

# The Java launcher that runs gnomish.jar.
GNOMISH_JAVA=java
