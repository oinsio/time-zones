#!/usr/bin/env bash
# Wrapper around the locally built Gnomish Factory jar (.gnomish/gnomish.jar, git-ignored).
# Lives in .gnomish/ with the rest of the factory setup; callable from any directory.
#
# Adds the defaults every invocation from this project needs, then passes the rest through:
#   --dir=<this project, absolute>     (a relative --dir is not recognised as a git repo in git mode)
#   --factory.instance-name=<project>  (this clone's name; keys logs, serve state and claim ids)
#   --factory.bindings.default=host    (the gnomes run on THIS machine — see the sandbox block)
#
# Every one of them is a plain default: pass your own --dir=... or
# --factory.bindings.default=container and yours REPLACES it — each default is dropped when
# the caller names the same key. That dropping is not decoration: Spring joins a repeated
# command-line option with a comma rather than letting the last one win, so a default left
# in place next to yours would produce `host,container`, not `container`.
#
# ---------------------------------------------------------------------------
# Sandbox (host binding — deliberate, and temporary)
#
# The factory's own default binding is `container`: an ephemeral Docker box per task, with
# default-deny egress. This project has no sandbox image yet, so the binding is pinned to
# `host` here — an explicit opt-in, because the factory refuses to weaken isolation silently.
#
# What host mode means, plainly: every gnome process — agent rounds, judge votes, command
# checks — runs on this machine as you. Its passport declares isolation: none.
#
#   * Filesystem: everything you can read, the gnome can read — ~/.ssh, cloud configs,
#     browser profiles. The environment allowlist below bounds VARIABLES, not files.
#   * Network: no egress control at all. Any process reaches any destination.
#   * Toolchain: taken from your PATH, not from an image. The specify stage needs `git`
#     and the OpenSpec CLI, and the gnome works in a worktree OUTSIDE this clone
#     (~/.gnomish/worktrees/time-zones/<task>), where node_modules does not exist — so the
#     CLI has to be installed globally, at the same version the repo pins:
#
#       brew install openspec            # this machine's install; brew upgrade openspec to bump
#       npm install -g @fission-ai/openspec@1.13.2   # or the npm package, pinned
#
#     Check with: openspec --version  (must match the pin in devDependencies of package.json)
#
# When the sandbox image lands, this becomes --factory.bindings.default=container plus
# --factory.sandbox.image / --factory.sandbox.egress-allowlist, and the global CLI install
# above stops mattering — the image bakes it.
#
# ---------------------------------------------------------------------------
# Secrets
#
# Secrets use the factory's own file indirection (EnvFileSecretsProvider): for a secret N it
# reads N_FILE as a path and takes the file's contents, so the token itself never enters this
# process's environment table. All this script does is point N_FILE at the local file. The
# files live OUTSIDE the clone — a token in the tree is one you can commit — and they are per
# project: ~/.gnomish/secrets/<project>, keyed by this clone's directory name, the same way
# the factory keys ~/.gnomish/worktrees/<project>. One token per project, revocable on its own.
#
#   mkdir -p ~/.gnomish/secrets/time-zones
#   install -m 600 /dev/null ~/.gnomish/secrets/time-zones/github-token
#   # paste the token in, no quotes and no KEY= prefix — the file IS the value
#
# GNOMISH_SECRETS_DIR moves the directory; GNOMISH_GITHUB_TOKEN_FILE names one file directly;
# an already-exported GNOMISH_GITHUB_TOKEN still works and is left alone.
#
# The log file is keyed by project the same way: ~/.gnomish/logs/<project>/gnomish.log.
# GNOMISH_LOG_DIR still wins if you set it yourself.
#
#   .gnomish/gnomish run --task="..." --mode=in-place --interactive
#   .gnomish/gnomish status <task-id>
set -euo pipefail

gnomish_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The project root is the parent of .gnomish/, wherever the script is called from.
project_dir="$(dirname "$gnomish_dir")"

# Keyed by the clone directory's own name, exactly as the factory keys its worktrees root
# (operator-guide-run.md: ~/.gnomish/worktrees/<project-name>/...), so two clones served by
# one factory never share a token by accident.
secrets_dir="${GNOMISH_SECRETS_DIR:-$HOME/.gnomish/secrets/$(basename "$project_dir")}"

# The factory's own default is one log file per host, so two factories started from two
# clones interleave their narratives into a single gnomish.log and neither one can be read
# on its own. Keying the directory by clone name gives each its own file to tail. Exported,
# not passed as a flag: logback reads it from the environment before Spring starts.
export GNOMISH_LOG_DIR="${GNOMISH_LOG_DIR:-$HOME/.gnomish/logs/$(basename "$project_dir")}"

warn_if_group_readable() {
    local file="$1" perms
    perms="$(stat -f %Lp "$file" 2>/dev/null || stat -c %a "$file" 2>/dev/null || echo "600")"
    if [[ "${perms: -2}" != "00" ]]; then
        echo "gnomish: $file is mode $perms — it holds a token, run: chmod 600 $file" >&2
    fi
}

# Point <SECRET>_FILE at the local file, but only when that file is actually there: the
# provider is fail-closed, so a _FILE naming a missing path resolves the secret as ABSENT
# instead of falling back to the plain variable — pointing it at nothing would break an
# operator who exports the token the old way.
point_at_file() {
    local var="$1" file="$2"
    [[ -f "$file" ]] || return 0
    if [[ -n "${!var:-}" ]]; then
        return 0  # an explicit path from the caller wins over the convention
    fi
    warn_if_group_readable "$file"
    export "$var=$file"
}

point_at_file GNOMISH_GITHUB_TOKEN_FILE "$secrets_dir/github-token"
point_at_file GNOMISH_GITHUB_ACTIONS_TOKEN_FILE "$secrets_dir/github-actions-token"

# The agent CLI's credential. On this host the CLI could log in from ~/.claude, but the
# factory sets this token on agent rounds and judge votes from its own environment, so
# storing it beside the others keeps the two bindings identical: nothing has to change here
# when the gnomes move into a box that has no keychain to log in from.
#
#   claude setup-token
#   install -m 600 /dev/null ~/.gnomish/secrets/time-zones/claude-oauth-token
#   # paste the token in — the file IS the value
#
# Unlike the tracker token this one is exported as a VALUE, not through a _FILE indirection:
# it is not a factory secret but an ordinary variable the factory reads live from its own
# environment and sets on agent rounds and judge votes alone (its AI seam) — it needs no
# passthrough entry and never reaches a command check.
claude_token_file="$secrets_dir/claude-oauth-token"
if [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" && -s "$claude_token_file" ]]; then
    warn_if_group_readable "$claude_token_file"
    token="$(tr -d '[:space:]' < "$claude_token_file")"
    # Only a non-empty value is exported. An empty one would not read as "unset" to the CLI —
    # it would override this host's keychain login with a credential that cannot authenticate.
    if [[ -n "$token" ]]; then
        CLAUDE_CODE_OAUTH_TOKEN="$token"
        export CLAUDE_CODE_OAUTH_TOKEN
    fi
    unset token
fi

if [[ -z "${GNOMISH_GITHUB_TOKEN_FILE:-}" && -z "${GNOMISH_GITHUB_TOKEN:-}" \
      && "${1:-}" != "--help" && "${1:-}" != "-h" ]]; then
    echo "gnomish: no $secrets_dir/github-token and no GNOMISH_GITHUB_TOKEN — tracker calls will fail" >&2
fi

# Defaults, each dropped when the caller passes the same key — see the note at the top on
# why a repeated Spring option must not simply be outranked.
defaults=(
    --dir="$project_dir"
    --factory.instance-name="$(basename "$project_dir")"
    --factory.bindings.default=host
)

applied=()
for default in "${defaults[@]}"; do
    key="${default%%=*}"
    overridden=0
    for arg in "$@"; do
        if [[ "$arg" == "$key="* || "$arg" == "$key" ]]; then
            overridden=1
            break
        fi
    done
    (( overridden )) || applied+=("$default")
done

exec java -jar "$gnomish_dir/gnomish.jar" \
    ${applied[@]+"${applied[@]}"} \
    "$@"
