diff --git a/.github/workflows/zone-rules-publication.yml b/.github/workflows/zone-rules-publication.yml
new file mode 100644
index 0000000..01e438d
--- /dev/null
+++ b/.github/workflows/zone-rules-publication.yml
@@ -0,0 +1,88 @@
+# Publishes a newer IANA zone rules release: compiles and checks it, commits it
+# to the default branch and deploys that commit. A failed step fails the run
+# and commits and deploys nothing.
+# Implements FR1 of add-remote-zone-rules-updates (design D7).
+name: Zone rules publication
+
+on:
+  schedule:
+    - cron: "17 4 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+# Publications never run in parallel
+concurrency:
+  group: zone-rules-publication
+  cancel-in-progress: false
+
+jobs:
+  publish:
+    name: Compile, check and commit a newer release
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    permissions:
+      contents: write
+    outputs:
+      release: ${{ steps.latest.outputs.release }}
+      commit: ${{ steps.commit.outputs.commit }}
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          ref: ${{ github.event.repository.default_branch }}
+
+      # pnpm version comes from `packageManager` in the root package.json
+      - uses: pnpm/action-setup@v4
+
+      - uses: actions/setup-node@v5
+        with:
+          node-version-file: .nvmrc
+          cache: pnpm
+
+      - run: pnpm install --frozen-lockfile
+
+      # Prints the newest listed release, or "already current"
+      - id: latest
+        run: pnpm --filter @time-zones/client zone-rules:latest
+
+      - name: Compile the release
+        if: steps.latest.outputs.release != ''
+        env:
+          RELEASE: ${{ steps.latest.outputs.release }}
+        run: pnpm --filter @time-zones/client zone-rules:compile "$RELEASE"
+
+      - name: Check the release against zdump
+        if: steps.latest.outputs.release != ''
+        run: pnpm --filter @time-zones/client zone-rules:check
+
+      - name: Run the unit tests on the new release
+        if: steps.latest.outputs.release != ''
+        run: pnpm test
+
+      - id: commit
+        name: Commit and push the release
+        if: steps.latest.outputs.release != ''
+        env:
+          RELEASE: ${{ steps.latest.outputs.release }}
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add packages/client/zone-rules/release.json
+          git commit -m "Update zone rules to $RELEASE"
+          git push
+          echo "commit=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
+
+  # A push made with GITHUB_TOKEN starts no workflow, so the deploy is called here
+  deploy:
+    name: Deploy the new release
+    needs: publish
+    if: needs.publish.outputs.commit != ''
+    uses: ./.github/workflows/deploy.yml
+    permissions:
+      contents: read
+      pull-requests: write
+      pages: write
+      id-token: write
+    with:
+      ref: ${{ needs.publish.outputs.commit }}
